{
  "name": "ezy-easy-yaml",
  "displayName": "EZY – Easy YAML",
  "description": "YAML-Vorlagen übersichtlich bearbeiten – mit Feldauswahl und Live-Vorschau.",
  "version": "0.2.0",
  "publisher": "ezy-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "ezy.open",
        "title": "EZY: Konfigurator öffnen"
      },
      {
        "command": "ezy.openTemplate",
        "title": "Mit EZY als Vorlage öffnen"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ezy.openTemplate",
          "when": "resourceExtname =~ /\\.(yml|yaml)$/i",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ezy.openTemplate",
          "when": "resourceExtname =~ /\\.(yml|yaml)$/i",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ezy.openTemplate",
          "when": "resourceExtname =~ /\\.(yml|yaml)$/i"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "vscode:prepublish": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "pretest:ui": "npm run build",
    "test:ui": "node test/ui.cjs",
    "pretest:integration": "npm run build",
    "test:integration": "node scripts/test-integration.cjs",
    "package": "vsce package --githubBranch main",
    "preassets": "npm run build",
    "assets": "node scripts/assets.cjs"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "icon": "assets/ezy-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/KingTiki/ezy-easyYaml.git"
  },
  "homepage": "https://github.com/KingTiki/ezy-easyYaml#readme",
  "bugs": {
    "url": "https://github.com/KingTiki/ezy-easyYaml/issues"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
